# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/research-extraction

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEIDENT_ENCRYPTION_KEY=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: which Clerk user IDs are allowed to manage AigentsConfig + PhiPolicy.
# Comma-separated list. If unset, only the first signed-up user gets admin.
CLERK_ADMIN_USER_IDS=

# Optional: lock down which origin can call /api/deident/*. If unset, allow same-origin only.
ALLOWED_ORIGIN=https://providerloop.org
