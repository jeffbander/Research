# Convex deployment URL — set automatically by `npx convex dev` on first run.
# In Vercel, copy from `npx convex deploy --cmd-url-env-var-name`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set this in Convex dashboard (Settings → Environment Variables), NOT in
# Next.js env. Convex actions read it at runtime.
DEIDENT_ENCRYPTION_KEY=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex needs this to verify Clerk-issued JWTs. Set in Convex env.
# Get it from Clerk dashboard → JWT Templates → Convex (you create the
# template) → "Issuer" field, e.g. https://moving-coyote-12.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Optional: which Clerk user IDs are allowed to manage AigentsConfig.
# Comma-separated list. Set in Convex env.
CLERK_ADMIN_USER_IDS=
